# OS cruft
.DS_Store
Thumbs.db

# Python bytecode cache from running scripts/sdd_check.py or its tests
__pycache__/
*.pyc

# Editor/IDE
.vscode/
.idea/
*.swp

# Superpowers subagent-driven-development scratch workspace
# (created under .superpowers/sdd/<plan-name>/ if a plan is ever executed
# with that skill in this repo — disposable once the plan's work is merged)
.superpowers/sdd/

# Local Claude Code session state (permission settings, headroom lock
# files) — machine-specific, not part of the skill itself.
.claude/

# docs/sdd/ worked examples are deliberately kept on disk but untracked —
# they demonstrate the klk- pipeline without bloating the repo's history
# with throwaway spec/story artifacts.
docs/sdd/

# examples/ holds the real source/tests backing a docs/sdd/ worked example
# (kept outside docs/sdd/ itself, per sdd-overview.md's rule that real
# project code doesn't belong there) — same disposable, untracked status.
examples/
